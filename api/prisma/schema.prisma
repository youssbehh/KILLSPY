// KILLSPY Prisma schema
// Cleaned Phase 6 — dropped legacy shop tables, added cosmetic system.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================================
// CORE
// =====================================================================

model Users {
  ID_User      Int       @id @default(autoincrement())
  Username     String    @unique
  Email        String    @unique
  Password     String
  MMR          Int       @default(0)
  Money        Int       @default(100)
  isGuest      Boolean   @default(false)
  CreatedAt    DateTime  @default(now())
  archived     Boolean   @default(false)
  deletionDate DateTime?
  XP            Int      @default(0)
  emailVerified Boolean  @default(false)
  banned        Boolean  @default(false)
  // Bumped on logout / password change: every token signed with an older value is rejected.
  tokenVersion  Int      @default(0)

  Roles       Roles[]
  Sessions    Session[]
  Friends     Friends[]     @relation("user_friendships")
  FriendOf    Friends[]     @relation("friend_of")
  Result      GameHistory[]
  Cosmetics   UserCosmetic[]
  Equipped    EquippedCosmetic[]
  Missions    PlayerMissionAssignment[]
  GuildMembership GuildMember?
  SentMessages     DirectMessage[] @relation("dm_sender")
  ReceivedMessages DirectMessage[] @relation("dm_receiver")
  Tokens           AccountToken[]
  Blocking         Block[]  @relation("blocker")
  BlockedBy        Block[]  @relation("blocked")
  ReportsFiled     Report[] @relation("reporter")
  ReportsReceived  Report[] @relation("reported")
  GuildMessages    GuildMessage[]
  GuildInvites     GuildInvite[] @relation("invitee")
  GuildInvitesSent GuildInvite[] @relation("inviter")

  @@index([MMR])
}

model Session {
  ID_Session      Int      @id @default(autoincrement())
  Connected       Boolean
  LastConnection  DateTime
  TotalLoginCount Int
  User            Users    @relation(fields: [ID_User], references: [ID_User], onDelete: Cascade)
  ID_User         Int
}

model Roles {
  ID_Role Int    @id @default(autoincrement())
  Role    String
  User    Users  @relation(fields: [ID_User], references: [ID_User], onDelete: Cascade)
  ID_User Int
}

enum FriendStatus {
  pending
  accepted
}

// One row per pair, owned by the requester (ID_User) and addressed to ID_Friend.
// Once accepted the friendship is mutual, whichever side asked.
model Friends {
  ID_Friendship Int      @id @default(autoincrement())
  // Rows created before friend requests existed are kept as accepted.
  Status        FriendStatus @default(accepted)
  Connected     Boolean  @default(false)
  Blocked       Boolean  @default(false)
  CreatedAt     DateTime @default(now())

  User      Users @relation("user_friendships", fields: [ID_User], references: [ID_User], onDelete: Cascade)
  ID_User   Int
  Friend    Users @relation("friend_of",        fields: [ID_Friend], references: [ID_User], onDelete: Cascade)
  ID_Friend Int

  @@unique([ID_User, ID_Friend])
  @@index([ID_Friend, Status])
}

model Block {
  id        Int      @id @default(autoincrement())
  blocker   Users    @relation("blocker", fields: [blockerId], references: [ID_User], onDelete: Cascade)
  blockerId Int
  blocked   Users    @relation("blocked", fields: [blockedId], references: [ID_User], onDelete: Cascade)
  blockedId Int
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

enum ReportStatus {
  open
  resolved
}

model Report {
  id         Int          @id @default(autoincrement())
  reporter   Users        @relation("reporter", fields: [reporterId], references: [ID_User], onDelete: Cascade)
  reporterId Int
  target     Users        @relation("reported", fields: [targetId], references: [ID_User], onDelete: Cascade)
  targetId   Int
  reason     String
  details    String?
  status     ReportStatus @default(open)
  createdAt  DateTime     @default(now())

  @@index([status, createdAt])
  @@index([targetId])
}

enum AccountTokenType {
  password_reset
  email_verify
}

// One-time codes sent by e-mail. Only the hash is stored.
model AccountToken {
  id        Int              @id @default(autoincrement())
  user      Users            @relation(fields: [userId], references: [ID_User], onDelete: Cascade)
  userId    Int
  type      AccountTokenType
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int              @default(0)
  createdAt DateTime         @default(now())

  @@index([userId, type])
}

// =====================================================================
// GAMES
// =====================================================================

enum GameModePersisted {
  pvp_quick
  pvp_ranked
  pve // training vs bot: history only, never rewarded
}

model GameHistory {
  ID_GameHistory Int               @id @default(autoincrement())
  V_D            Boolean
  Draw           Boolean           @default(false)
  Rounds         Int               @default(0)
  OpponentId     Int?
  XPWin          Int               @default(0)
  DateGame       DateTime          @default(now())
  MMRWin         Int               @default(0)
  Mode           GameModePersisted @default(pvp_quick)
  User           Users             @relation(fields: [ID_User], references: [ID_User], onDelete: Cascade)
  ID_User        Int

  @@index([ID_User, Mode, DateGame])
  @@index([ID_User, DateGame])
}

// =====================================================================
// COSMETICS / SHOP
// =====================================================================

enum CosmeticType {
  avatar         // photo de profil
  card_skin      // habillage des cartes / interface jeu
  emote          // réaction in-game
  background     // fond achetable (différent du thème UI)
  ui_theme       // thème de couleurs de l'UI (5 variantes proposées + défaut offert)
  shoot_anim     // animation de tir (futur)
  shield_anim    // animation de bouclier (futur)
  name_effect    // effet visuel sur le pseudo (futur)
}

enum Rarity {
  common      // gris
  uncommon    // vert
  rare        // bleu
  epic        // violet
  legendary   // or
  mythic      // rouge
  secret      // noir étoilé
}

model CosmeticItem {
  id        Int          @id @default(autoincrement())
  type      CosmeticType
  name      String       @unique
  imageUrl  String
  basePrice Int
  rarity    Rarity       @default(common)
  available Boolean      @default(true)
  createdAt DateTime     @default(now())

  owned     UserCosmetic[]
  equipped  EquippedCosmetic[]
  offers    ShopOffer[]

  @@index([type, available])
  @@index([rarity])
}

model UserCosmetic {
  id         Int          @id @default(autoincrement())
  user       Users        @relation(fields: [userId], references: [ID_User], onDelete: Cascade)
  userId     Int
  item       CosmeticItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId     Int
  pricePaid  Int
  acquiredAt DateTime     @default(now())

  @@unique([userId, itemId])
  @@index([userId])
}

model EquippedCosmetic {
  id     Int          @id @default(autoincrement())
  user   Users        @relation(fields: [userId], references: [ID_User], onDelete: Cascade)
  userId Int
  type   CosmeticType
  item   CosmeticItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId Int

  @@unique([userId, type])
  @@index([userId])
}

model ShopOffer {
  id         Int          @id @default(autoincrement())
  item       CosmeticItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId     Int
  price      Int
  validUntil DateTime
  position   Int          @default(0)
  active     Boolean      @default(true)

  @@index([active, validUntil])
}

// =====================================================================
// DAILY MISSIONS
// =====================================================================

// Metric tracked via GameHistory (no extra columns needed).
enum MissionMetric {
  wins           // V_D=true, any mode
  rounds_played  // any game
  ranked_wins    // V_D=true, pvp_ranked
  ranked_played  // pvp_ranked
}

// Static pool of missions. Seed once, never changes in production.
model MissionTemplate {
  id        Int            @id @default(autoincrement())
  slug      String         @unique
  title     String
  metric    MissionMetric
  target    Int
  xpReward  Int
  active    Boolean        @default(true)

  assignments PlayerMissionAssignment[]

  @@index([active])
}

// One row per (player, mission, UTC-day). Created lazily on first GET /missions/daily.
// Progress is NOT stored here — it's computed live from GameHistory.
// `rewarded` flips to true when the player claims their XP (POST /missions/daily/:id/claim).
model PlayerMissionAssignment {
  id        Int              @id @default(autoincrement())
  userId    Int
  missionId Int
  day       String           // "YYYY-MM-DD" UTC
  rewarded  Boolean          @default(false)

  user    Users           @relation(fields: [userId],    references: [ID_User], onDelete: Cascade)
  mission MissionTemplate @relation(fields: [missionId], references: [id],      onDelete: Cascade)

  @@unique([userId, missionId, day])
  @@index([userId, day])
}

// =====================================================================
// GUILDS
// =====================================================================

enum GuildRole {
  LEADER
  OFFICER
  MEMBER
}

model Guild {
  id          Int      @id @default(autoincrement())
  name        String   @unique          // max 24 chars
  tag         String   @unique          // 2-5 uppercase letters displayed as [TAG]
  description String?
  isOpen      Boolean  @default(true)   // open = anyone can join
  maxMembers  Int      @default(30)
  createdAt   DateTime @default(now())

  members  GuildMember[]
  messages GuildMessage[]
  invites  GuildInvite[]

  @@index([name])
}

model GuildMember {
  id       Int       @id @default(autoincrement())
  guild    Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  guildId  Int
  user     Users     @relation(fields: [userId], references: [ID_User], onDelete: Cascade)
  userId   Int       @unique          // one guild per player
  role     GuildRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@index([guildId])
}

model GuildMessage {
  id       Int      @id @default(autoincrement())
  guild    Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  guildId  Int
  sender   Users    @relation(fields: [senderId], references: [ID_User], onDelete: Cascade)
  senderId Int
  content  String
  sentAt   DateTime @default(now())

  @@index([guildId, id])
}

model GuildInvite {
  id          Int      @id @default(autoincrement())
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  guildId     Int
  user        Users    @relation("invitee", fields: [userId], references: [ID_User], onDelete: Cascade)
  userId      Int
  invitedBy   Users    @relation("inviter", fields: [invitedById], references: [ID_User], onDelete: Cascade)
  invitedById Int
  createdAt   DateTime @default(now())

  @@unique([guildId, userId])
  @@index([userId])
}

// =====================================================================
// DIRECT MESSAGES
// =====================================================================

model DirectMessage {
  id         Int       @id @default(autoincrement())
  sender     Users     @relation("dm_sender",   fields: [senderId],   references: [ID_User], onDelete: Cascade)
  senderId   Int
  receiver   Users     @relation("dm_receiver", fields: [receiverId], references: [ID_User], onDelete: Cascade)
  receiverId Int
  content    String
  sentAt     DateTime  @default(now())
  readAt     DateTime?

  @@index([senderId, receiverId, sentAt])
  @@index([receiverId, senderId, id])
  @@index([receiverId, readAt])
}
